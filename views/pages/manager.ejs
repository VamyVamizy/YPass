<% const activeFilters = filters || {}; %>
<% const kioskLocationIds = new Set(kiosks.map((kiosk) => String(kiosk.location_id))); %>
<section class="staff-page">
  <script nonce="<%= cspNonce %>" src="/js/active-pass-timer.js?v=2" defer></script>
  <div class="staff-heading">
    <div>
      <h4>
        🗒 <time data-language-ignore><%= new Date().toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' }) %></time>
      </h4>
      <div class="h-line"></div>
      <h1>Hello, <%= currentUser.display_name.split(',')[1]?.trim() %></h1>
      <li class="teacher-data">
        <div class="account-info-box">✉ <%= currentUser.primary_email || 'no email' %> <span class="small-muted">(admin)</span></div>
        <form class="inline" method="post" action="/auth/logout">
          <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>" />
          <button type="submit">↰ Sign out</button>
        </form>
      </li>
    </div>
  </div>
  <nav class="manager-tabs" role="tablist" aria-label="Manager sections">
    <button id="manager-tab-students" type="button" class="manager-tab is-active" role="tab" data-tab="students" aria-controls="manager-panel-students" aria-selected="true" tabindex="0"><img src="/images/person.svg" width="15" height="15">Students</button>
    <button id="manager-tab-locations" type="button" class="manager-tab" role="tab" data-tab="locations" aria-controls="manager-panel-locations" aria-selected="false" tabindex="-1"><img src="/images/location.svg" width="20" height="20">Locations</button>
    <button id="manager-tab-kiosks" type="button" class="manager-tab" role="tab" data-tab="kiosks" aria-controls="manager-panel-kiosks" aria-selected="false" tabindex="-1"><img src="/images/kiosk.svg" width="15" height="15">Kiosks</button>
    <div class="manager-tab-divider"></div>
    <button id="manager-tab-passes" type="button" class="manager-tab" role="tab" data-tab="passes" aria-controls="manager-panel-passes" aria-selected="false" tabindex="-1"><img src="/images/ticket.svg" width="15" height="15">Passes</button>
    <button id="manager-tab-appointments" type="button" class="manager-tab" role="tab" data-tab="appointments" aria-controls="manager-panel-appointments" aria-selected="false" tabindex="-1"><img src="/images/timer.svg" width="15" height="15">Appointments</button>
    <div class="manager-tab-divider"></div>
    <button id="manager-tab-user-roles" type="button" class="manager-tab" role="tab" data-tab="user-roles" aria-controls="manager-panel-user-roles" aria-selected="false" tabindex="-1"><img src="/images/roles.svg" width="17" height="17">User roles</button>
    <% if (sisEnabled) { %>
      <button id="manager-tab-sis" type="button" class="manager-tab" role="tab" data-tab="sis" aria-controls="manager-panel-sis" aria-selected="false" tabindex="-1"><img src="/images/gear.svg" width="20" height="20">SIS</button>
    <% } %>
  </nav>
  <div id="manager-panel-students" class="manager-tab-panel is-active" role="tabpanel" aria-labelledby="manager-tab-students" tabindex="0" data-panel="students">
    <section class="staff-section">
      <form method="post" action="/manager/students/create" class="staff-form manager-form">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <label>
          <h4 class="small-muted">Name<span class="required-note"> *</span></h4>
          <input name="studentName" required maxlength="120">
        </label>
        <label>
          <h4 class="small-muted">Student ID<span class="required-note"> *</span></h4>
          <input name="studentNumber" required maxlength="64">
        </label>
        <label>
          <h4 class="small-muted">Status</h4>
          <select name="status">
            <option value="active">Active</option>
            <option value="inactive">Inactive</option>
          </select>
        </label>
        <button type="submit">+ Add student</button>
      </form>
      <br>
      <div class="header-cont">
        <img src="/images/person.svg" width="20" height="20">
        <h2>All students</h2>
      </div>
      <label class="student-search">
        <input type="search" data-student-search placeholder="⌕ Search students by name or ID" autocomplete="off">
      </label>
      <div class="staff-list">
        <% students.forEach((student) => { %>
          <form method="post" action="/manager/students/update" class="staff-row manager-form student-row" data-bulk-save-form data-student-name="<%= student.display_name %>" data-student-id="<%= student.student_number %>">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <input type="hidden" name="id" value="<%= student.id %>">
            <label>
              <h4 class="small-muted">Name</h4>
              <input name="studentName" value="<%= student.display_name %>" required maxlength="120">
            </label>
            <label>
              <h4 class="small-muted">Student ID</h4>
              <input name="studentNumber" value="<%= student.student_number %>" required maxlength="64">
            </label>
            <label>
              <h4 class="small-muted">Status</h4>
              <select name="status">
                <option value="active" <%= student.status === 'active' ? 'selected' : '' %>>Active</option>
                <option value="inactive" <%= student.status === 'inactive' ? 'selected' : '' %>>Inactive</option>
              </select>
            </label>
            <button type="submit"><img src="/images/save.svg" width="15" height="15">Save</button>
            <button type="submit" formaction="/manager/students/delete" formmethod="POST" class="danger-button decline"><img src="/images/trash.svg" width="15" height="15">Delete</button>
          </form>
        <% }) %>
      </div>
      <div class="manager-bulk-actions">
        <button type="button" data-bulk-save="students"><img src="/images/save.svg" width="15" height="15">Save all changes</button>
        <span class="manager-bulk-status" data-bulk-status="students" role="status" aria-live="polite"></span>
      </div>
    </section>
  </div>
  <div id="manager-panel-locations" class="manager-tab-panel" role="tabpanel" aria-labelledby="manager-tab-locations" tabindex="0" data-panel="locations">
    <section class="staff-section">
      <form method="post" action="/manager/locations/create" class="staff-form manager-form">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <label>
          <h4 class="small-muted">Name<span class="required-note"> *</span></h4>
          <input name="name" required maxlength="120">
        </label>
        <label>
          <h4 class="small-muted">Type</h4>
          <select name="type">
            <option value="round_trip">Round trip</option>
            <option value="one_way">One way</option>
            <option value="bathroom">Bathroom</option>
          </select>
        </label>
        <label>
          <h4 class="small-muted">Bathroom</h4>
          <select name="bathroom">
            <option value="">Unassigned</option>
            <% bathrooms.forEach((bathroom) => { %>
              <option value="<%= bathroom.id %>"><%= bathroom.name %></option>
            <% }) %>
          </select>
        </label>
        <label>
          <h4 class="small-muted">Staff member</h4>
          <select name="teacherUserId">
            <option value="">Unassigned</option>
            <% locationAssignees.forEach((user) => { %>
              <option value="<%= user.id %>"><%= user.display_name %></option>
            <% }) %>
          </select>
        </label>
        <label>
          <h4 class="small-muted">Default</h4>
          <select name="defaultLocation">
            <option value="false">No</option>
            <option value="true">Yes</option>
          </select>
        </label>
        <label>
          <h4 class="small-muted">Active</h4>
          <select name="active">
            <option value="true">Active</option>
            <option value="false">Inactive</option>
          </select>
        </label>
        <button type="submit">+ Add location</button>
      </form>
      <br>
      <div class="header-cont">
        <img src="/images/location.svg" width="25" height="25">
        <h2>All locations</h2>
      </div>
      <label class="student-search">
        <input type="search" data-location-search placeholder="⌕ Search locations by name or teacher" autocomplete="off">
      </label>
      <div class="staff-list">
        <% locations.forEach((location) => { %>
          <form method="post" action="/manager/locations/update" class="staff-row manager-form location-row" data-bulk-save-form data-location-name="<%= location.name %>" data-location-teacher="<%= users.find((user) => user.id === location.teacher_user_id)?.display_name || '' %>">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <input type="hidden" name="id" value="<%= location.id %>">
            <label>
              <h4 class="small-muted">Name</h4>
              <input name="name" value="<%= location.name %>" required maxlength="120">
            </label>
            <label>
              <h4 class="small-muted">Type</h4>
              <select name="type">
                <% ['round_trip', 'one_way', 'bathroom'].forEach((type) => { %>
                  <option value="<%= type %>" <%= location.type === type ? 'selected' : '' %>>
                    <%= type === 'round_trip' ? 'Round trip' : type === 'one_way' ? 'One way' : 'Bathroom'  %>
                  </option>
                <% }) %>
              </select>
            </label>
            <label>
              <h4 class="small-muted">Bathroom</h4>
              <select name="bathroom">
                <option value="">Unassigned</option>
                <% bathrooms.forEach((bathroom) => { %>
                  <option value="<%= bathroom.id %>" <%= String(location.bathroom || '') === String(bathroom.id) ? 'selected' : '' %>><%= bathroom.name %></option>
                <% }) %>
              </select>
            </label>
            <label>
              <h4 class="small-muted">Staff member</h4>
              <select name="teacherUserId">
                <option value="">Unassigned</option>
                <% locationAssignees.forEach((user) => { %>
                  <option value="<%= user.id %>" <%= location.teacher_user_id === user.id ? 'selected' : '' %>><%= user.display_name %></option>
                <% }) %>
              </select>
            </label>
            <label>
              <h4 class="small-muted">Default</h4>
              <select name="defaultLocation">
                <option value="false" <%= !location.default_location ? 'selected' : '' %>>No</option>
                <option value="true" <%= location.default_location ? 'selected' : '' %>>Yes</option>
              </select>
            </label>
            <label>
              <h4 class="small-muted">Active</h4>
              <select name="active">
                <option value="true" <%= location.active ? 'selected' : '' %>>Active</option>
                <option value="false" <%= !location.active ? 'selected' : '' %>>Inactive</option>
              </select>
            </label>
            <button type="submit"><img src="/images/save.svg" width="15" height="15">Save</button>
            <button type="submit" formaction="/manager/locations/delete" formmethod="POST" class="danger-button decline"><img src="/images/trash.svg" width="15" height="15">Delete</button>
          </form>
        <% }) %>
      </div>
      <div class="manager-bulk-actions">
        <button type="button" data-bulk-save="locations"><img src="/images/save.svg" width="15" height="15">Save all changes</button>
        <span class="manager-bulk-status" data-bulk-status="locations" role="status" aria-live="polite"></span>
      </div>
    </section>
  </div>
  <div id="manager-panel-kiosks" class="manager-tab-panel" role="tabpanel" aria-labelledby="manager-tab-kiosks" tabindex="0" data-panel="kiosks">
    <section class="staff-section">
      <form method="post" action="/manager/kiosks/enrollment/complete" class="staff-form manager-form">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <label>
          <h4 class="small-muted">Name<span class="required-note"> *</span></h4>
          <input name="name" required maxlength="120">
        </label>
        <label>
          <h4 class="small-muted">Enrollment code<span class="required-note"> *</span></h4>
          <input name="enrollmentCode" required maxlength="16" placeholder="8K4P-29QX" autocomplete="off">
        </label>
        <label>
          <h4 class="small-muted">Location<span class="required-note"> *</span></h4>
          <select name="locationId" required>
            <% locations.filter((location) => location.active && !kioskLocationIds.has(String(location.id))).forEach((location) => { %>
              <option data-language-ignore value="<%= location.id %>"><%= location.name %></option>
            <% }) %>
          </select>
        </label>
        <button type="submit">+ Register kiosk</button>
      </form>
      <br>
      <div class="header-cont">
        <img src="/images/kiosk.svg" width="20" height="20">
        <h2>All kiosks</h2>
      </div>
      <label class="student-search">
        <input type="search" data-kiosk-search placeholder="⌕ Search kiosks by name, code, or location" autocomplete="off">
      </label>
      <div class="staff-list">
        <% kiosks.forEach((kiosk) => { %>
          <form method="post" action="/manager/kiosks/update" class="staff-row manager-form kiosk-row <%= kiosk.display_status %>" data-bulk-save-form data-kiosk-name="<%= kiosk.name %>" data-kiosk-code="<%= kiosk.kiosk_code %>" data-kiosk-location="<%= kiosk.location_name %>">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <input type="hidden" name="id" value="<%= kiosk.id %>">
            <label>
              <h4 class="small-muted">Name</h4>
              <input name="name" value="<%= kiosk.name %>" required maxlength="120">
            </label>
            <label>
              <h4 class="small-muted">Code</h4>
              <input name="kioskCode" value="<%= kiosk.kiosk_code %>" required maxlength="64">
            </label>
            <label>
              <h4 class="small-muted">Location</h4>
              <select name="locationId">
                <option value="" <%= !kiosk.location_id ? 'selected' : '' %>>Unassigned</option>
                <% locations.filter((location) => !kioskLocationIds.has(String(location.id)) || String(kiosk.location_id) === String(location.id)).forEach((location) => { %>
                  <option data-language-ignore value="<%= location.id %>" <%= kiosk.location_id === location.id ? 'selected' : '' %>><%= location.name %></option>
                <% }) %>
              </select>
            </label>
            <label>
              <h4 class="small-muted">Active</h4>
              <select name="active">
                <option value="true" <%= kiosk.active ? 'selected' : '' %>>Active</option>
                <option value="false" <%= !kiosk.active ? 'selected' : '' %>>Inactive</option>
              </select>
            </label>
            <button type="submit"><img src="/images/save.svg" width="15" height="15">Save</button>
            <button type="submit" formaction="/manager/kiosks/delete" formmethod="POST" class="danger-button decline"><img src="/images/trash.svg" width="15" height="15">Delete</button>
          </form>
        <% }) %>
      </div>
      <div class="manager-bulk-actions">
        <button type="button" data-bulk-save="kiosks"><img src="/images/save.svg" width="15" height="15">Save all changes</button>
        <span class="manager-bulk-status" data-bulk-status="kiosks" role="status" aria-live="polite"></span>
      </div>
    </section>
  </div>
  <div id="manager-panel-passes" class="manager-tab-panel" role="tabpanel" aria-labelledby="manager-tab-passes" tabindex="0" data-panel="passes">
    <section class="staff-section">
      <div class="staff-section">
        <label class="student-search">
          <input type="search" data-manager-pass-search placeholder="⌕ Search passes by student, ID, destination, or status" autocomplete="off">
        </label>
        <% if (!passes.length) { %>
          <p class="muted">No passes match these filters.</p>
        <% } %>
        <div class="staff-list">
          <% passes.forEach((pass) => { %>
            <article class="staff-row pass-row <%= pass.status %>" data-manager-pass-row data-pass-student="<%= pass.student_name %>" data-pass-number="<%= pass.student_number %>" data-pass-origin="<%= pass.origin_name || 'Unassigned' %>" data-pass-destination="<%= pass.destination_name || 'Unassigned' %>" data-pass-status="<%= pass.display_status %>">
              <div class="pass-identity">
                <div class="passes-header-wrap"><strong><%= pass.student_name %></strong></div>
                <p><% if (pass.active_live && pass.active_duration) { %><span data-active-pass-timer data-active-since="<%= pass.active_since %>" data-active-live="true" data-active-duration-label="<%= pass.active_duration_label %>"><%= pass.active_duration %></span><% } else if (pass.finished_at) { %><time data-finished-at="<%= pass.finished_at %>">Finished <%= pass.finished_at_display || pass.finished_at %></time><% } %></p>
                <h4 class="small-muted">🇮🇩 <%= pass.student_number %></h4>
              </div>
              <div class="pass-details">
                <div class="passes-footer-wrap">
                  <div>Destination</div>
                  <h4 class="small-muted"><span data-language-ignore><%= pass.destination_name %></span></h4>
                </div>
              </div>
            </article>
          <% }) %>
        </div>
      </div>
    </section>
  </div>
  <div id="manager-panel-appointments" class="manager-tab-panel" role="tabpanel" aria-labelledby="manager-tab-appointments" tabindex="0" data-panel="appointments">
    <section class="staff-section">
      <label class="student-search">
        <input type="search" data-manager-appointment-search placeholder="⌕ Search appointments by student, ID, location, or status" autocomplete="off">
      </label>
      <% if (!appointments.length) { %>
        <p class="muted">No appointments match these filters.</p>
      <% } %>
      <div class="staff-list">
        <% appointments.forEach((appointment) => { %>
          <article class="staff-row pass-row appointment-row <%= appointment.status %>" data-manager-appointment-row data-appointment-search-text="<%= [appointment.student_name, appointment.student_number, appointment.origin_name, appointment.destination_name, appointment.status].join(' ') %>">
            <div class="pass-identity">
              <div class="passes-header-wrap"><strong><%= appointment.student_name %></strong></div>
              <h4 class="small-muted">🇮🇩 <%= appointment.student_number %></h4>
            </div>
            <div class="pass-details">
              <div class="passes-footer-wrap">
                <div>Appointment</div>
                <h4 class="small-muted"><span data-language-ignore><%= appointment.origin_name %></span> → <span data-language-ignore><%= appointment.destination_name %></span></h4>
              </div>
            </div>
            <span class="status-label appointment-status">⏱︎ <%= appointment.status %> · <%= appointment.scheduled_at_display %></span>
          </article>
        <% }) %>
      </div>
    </section>
  </div>
  <% if (sisEnabled) { %>
    <div id="manager-panel-sis" class="manager-tab-panel" role="tabpanel" aria-labelledby="manager-tab-sis" tabindex="0" data-panel="sis">
      <section class="staff-section">
        <form method="post" class="staff-form manager-form" data-sis-create>
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <label>
            <h4 class="small-muted">Name<span class="required-note"> *</span></h4>
            <input name="connectionName" required maxlength="120">
          </label>
          <label>
            <h4 class="small-muted">Provider<span class="required-note"> *</span></h4>
            <select name="provider">
              <option value="mock">Mock</option>
              <option value="oneroster">OneRoster</option>
              <option value="skyward">Skyward</option>
              <option value="schoology">Schoology</option>
            </select>
          </label>
          <label>
            <h4 class="small-muted">Base URL<span class="required-note"> *</span></h4>
            <input name="baseUrl" type="url" placeholder="https://sis.example.test">
          </label>
          <label>
            <h4 class="small-muted">Protocol<span class="required-note"> *</span></h4>
            <select name="protocol">
              <option value="oneroster">OneRoster</option>
              <option value="api">Vendor API</option>
            </select>
          </label>
          <label>
            <h4 class="small-muted">Platform<span class="required-note"> *</span></h4>
            <select name="platform">
              <option value="qmlativ">Skyward Qmlativ</option>
              <option value="sms20">Skyward SMS 2.0</option>
            </select>
          </label>
          <label>
            <h4 class="small-muted">Student path</h4>
            <input name="studentPath" placeholder="/api/qmlativ/students">
          </label>
          <label>
            <h4 class="small-muted">OneRoster Version<span class="required-note"> *</span></h4>
            <select name="version">
              <option value="1.1">1.1</option>
              <option value="1.2">1.2</option>
            </select>
          </label>
          <label>
            <h4 class="small-muted">Auth Type<span class="required-note"> *</span></h4>
            <select name="authType">
              <option value="bearer">Bearer token</option>
              <option value="basic">Basic</option>
              <option value="oauth1">Schoology OAuth 1.0a</option>
              <option value="apiKey">Skyward API key</option>
            </select>
          </label>
          <label>
            <h4 class="small-muted">Username<span class="required-note"> *</span></h4>
            <input name="username" autocomplete="off">
          </label>
          <label>
            <h4 class="small-muted">Password<span class="required-note"> *</span></h4>
            <input name="password" type="password" autocomplete="new-password">
          </label>
          <label>
            <h4 class="small-muted">Token<span class="required-note"> *</span></h4>
            <input name="token" type="password" autocomplete="new-password">
          </label>
          <label>
            <h4 class="small-muted">API key<span class="required-note"> *</span></h4>
            <input name="apiKey" type="password" autocomplete="new-password">
          </label>
          <label>
            <h4 class="small-muted">Consumer key<span class="required-note"> *</span></h4>
            <input name="consumerKey" autocomplete="off">
          </label>
          <label>
            <h4 class="small-muted">Consumer secret<span class="required-note"> *</span></h4>
            <input name="consumerSecret" type="password" autocomplete="new-password">
          </label>
          <label>
            <h4 class="small-muted">Token secret<span class="required-note"> *</span></h4>
            <input name="tokenSecret" type="password" autocomplete="new-password">
          </label>
          <label>
            <h4 class="small-muted">Sync interval (seconds)<span class="required-note"> *</span></h4>
            <input name="syncIntervalSeconds" type="number" min="0" max="86400" value="0">
          </label>
          <button type="submit"><img src="/images/save.svg" width="15" height="15">Save connection</button>
          <output data-sis-message class="muted"></output>
        </form>

        <% if (sisConnections) { %>
          <div class="staff-list" data-sis-list>
            <% sisConnections.forEach((connection) => { %>
              <article class="staff-row" data-sis-connection data-connection-id="<%= connection.id %>">
                <div>
                  <strong><%= connection.connection_name %></strong>
                  <p><%= connection.provider %> · <%= connection.active ? 'Active' : 'Inactive' %> · Last sync: <%= connection.last_synced_at || 'Never' %></p>
                  <pre data-sis-history hidden></pre>
                </div>
                <span class="manager-form">
                  <button type="button" data-sis-test>Test</button>
                  <button type="button" data-sis-sync>Sync</button>
                  <button type="button" data-sis-history-toggle>History</button>
                  <button type="button" data-sis-delete>Delete</button>
                </span>
              </article>
            <% }) %>
          </div>
        <% } %>
      </section>
    </div>
    <script nonce="<%= cspNonce %>" src="/js/sis-manager.js?v=2" defer></script>
  <% } %>
  <script nonce="<%= cspNonce %>" src="/js/manager-bulk-save.js?v=1" defer></script>
  <div id="manager-panel-user-roles" class="manager-tab-panel" role="tabpanel" aria-labelledby="manager-tab-user-roles" tabindex="0" data-panel="user-roles">
    <section class="staff-section">
      <label class="student-search">
        <input type="search" data-user-role-search placeholder="⌕ Search users by name, email, or role" autocomplete="off">
      </label>
      <div class="staff-list">
        <% users.forEach((user) => { %>
          <form method="post" action="/manager/users/role" class="staff-row manager-form" data-bulk-save-form data-user-role-row data-user-role-search-text="<%= [user.display_name, user.primary_email || '', ...(user.roles || []), ...(user.roles?.length ? [] : ['student'])].join(' ') %>">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <input type="hidden" name="userId" value="<%= user.id %>">
            <div>
              <strong><%= user.display_name %></strong>
              <p>✉ <%= user.primary_email || 'No email' %> | <strong class="small-muted"><%= user.roles?.join(', ') || 'student' %></strong></p>
            </div>
            <label>
              Role
              <select name="roleName">
                <% ['student', 'teacher', 'manager'].forEach((role) => { %>
                  <option value="<%= role %>" <%= user.roles?.includes(role) ? 'selected' : '' %>><%= role %></option>
                <% }) %>
              </select>
            </label>
            <button type="submit"><img src="/images/save.svg" width="15" height="15">Save</button>
          </form>
        <% }) %>
      </div>
      <div class="manager-bulk-actions">
        <button type="button" data-bulk-save="user-roles"><img src="/images/save.svg" width="15" height="15">Save all changes</button>
        <span class="manager-bulk-status" data-bulk-status="user-roles" role="status" aria-live="polite"></span>
      </div>
    </section>
  </div>
  <script nonce="<%= cspNonce %>" src="/js/manager-tabs.js?v=2" defer></script>
  <script nonce="<%= cspNonce %>" src="/js/student-search.js?v=3" defer></script>
</section>
