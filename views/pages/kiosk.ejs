<section class="kiosk-page">
  <% const waitingForApproval = (typeof action !== 'undefined' && action === 'pending') || (typeof pass !== 'undefined' && pass && pass.status === 'pending_approval');%>
  <div class="kiosk-heading">
    <div>
      <p class="kiosk-kicker">Student Kiosk</p>
      <h1><%= kiosk.name %></h1>
      <p class="small-muted">Scan a student ID to request a pass or record a return.</p>
    </div>
    <div class="kiosk-status"><img src="/images/power-outline.svg" width="15" height="15">Ready</div>
  </div>

  <% if (message) { %>
    <div class="kiosk-message kiosk-message-<%= message.type %>" role="status"><%= message.text %></div>
  <% } %>

  <div class="kiosk-grid" <% if (waitingForApproval && kioskSession) { %>data-kiosk-pending<% } %>>
    <section class="kiosk-panel kiosk-scan-panel">
      <div class="panel-heading">
        <div>
          <h2>⌕ Identify student</h2>
          <p>Use the barcode scanner or type the student ID.</p>
        </div>
      </div>
      <form method="post" action="/kiosk/scan" class="kiosk-form kiosk-scan-form" <% if (waitingForApproval) { %> aria-disabled="true" <% } %>>
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <% if (!kioskSession) { %><input type="hidden" name="kioskCode" value="<%= kioskCode %>"><% } %>
        <label for="studentNumber">Student ID</label>
        <div class="scan-input-wrap">
          <span class="scan-icon" aria-hidden="true">#</span>
          <input id="studentNumber" name="studentNumber" value="<%= form.studentNumber || '' %>" required autofocus autocomplete="off" inputmode="numeric" placeholder="Scan barcode" <% if (waitingForApproval) { %> readonly <% } %> >
        </div>
        <% if (!waitingForApproval) { %><button type="submit" class="primary-button">Continue</button><% } %>
      </form>
      <p class="scanner-note"><%= waitingForApproval ? 'ⓘ This kiosk is locked until the teacher accepts or cancels the pass.' : 'ⓘ A USB barcode scanner works like a keyboard. Keep this field focused.' %></p>
    </section>

    <% if (appointmentPrompt) { %>
      <section class="kiosk-panel kiosk-appointment-panel">
        <div class="panel-heading">
          <div>
            <h2>⏱︎ Upcoming appointment</h2>
            <p>Would you like to go to the appointment now?</p>
          </div>
        </div>
        <form method="post" action="/kiosk/scan" class="kiosk-form">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <% if (!kioskSession) { %><input type="hidden" name="kioskCode" value="<%= kioskCode %>"><% } %>
          <input type="hidden" name="studentNumber" value="<%= student?.student_number || form.studentNumber || '' %>">
          <div class="appointment-actions">
            <button type="submit" class="secondary-button" name="appointmentAction" value="decline">No</button>
            <button type="submit" class="primary-button" name="appointmentAction" value="show">Yes</button>
          </div>
        </form>
      </section>
    <% } %>

    <% if (appointmentChoices && appointmentChoices.length) { %>
      <section class="kiosk-panel kiosk-appointment-panel">
        <div class="panel-heading">
          <div>
            <h2>⏱︎ Choose appointment</h2>
            <p>Select the appointment to complete now.</p>
          </div>
        </div>
        <% appointmentChoices.forEach((appointment) => { %>
          <form method="post" action="/kiosk/scan" class="kiosk-form appointment-choice-form">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <% if (!kioskSession) { %><input type="hidden" name="kioskCode" value="<%= kioskCode %>"><% } %>
            <input type="hidden" name="studentNumber" value="<%= form.studentNumber || student?.student_number || appointment.student_id || '' %>">
            <input type="hidden" name="appointmentAction" value="complete">
            <input type="hidden" name="appointmentId" value="<%= appointment.id %>">
            <button type="submit" class="appointment-choice-button">
              <strong><span data-language-ignore><%= appointment.origin_name %></span> to <span data-language-ignore><%= appointment.destination_name %></span></strong>
              <span><%= new Date(appointment.scheduled_at).toLocaleString([], { dateStyle: 'medium', timeStyle: 'short' }) %></span>
            </button>
          </form>
        <% }) %>
      </section>
    <% } %>

    <% if (action === 'create' || action === 'pending' || pass?.status === 'pending_approval') { %>
      <section class="kiosk-panel kiosk-destination-panel">
        <div class="panel-heading">
          <div>
            <h2>⌂ Choose destination</h2>
          </div>
        </div>
        <form method="post" action="/kiosk/pass" class="kiosk-form" <% if (waitingForApproval) { %> aria-disabled="true" <% } %>>
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <% if (!kioskSession) { %><input type="hidden" name="kioskCode" value="<%= kioskCode %>"><% } %>
          <% if (waitingForApproval) { %>
            <label for="lockedStudentNumber">Student ID</label>
            <input id="lockedStudentNumber" name="studentNumber" value="<%= student.student_number %>" readonly>
            <label for="lockedStudentName">Student</label>
            <input id="lockedStudentName" name="studentName" value="<%= student.display_name %>" readonly>
          <% } else { %>
            <input type="hidden" name="studentNumber" value="<%= student.student_number || form.studentNumber || '' %>">
            <input type="hidden" name="studentName" value="<%= student.display_name || form.studentName || '' %>">
          <% } %>
          <input name="defaultLocations" type="hidden" value="<%= JSON.stringify(destinations) %>">
          <input id="destinationSearch" type="search" placeholder="⌕ Search by location or teacher" autocomplete="off" data-destination-search <% if (waitingForApproval) { %> disabled <% } %>>
          <input type="hidden" name="destinationLocationId" value="<%= form.destinationLocationId || '' %>" data-destination-value required>
          <div class="destination-list" role="listbox" aria-label="Destinations" data-destination-list <% if (waitingForApproval) { %> aria-disabled="true" <% } %>>
            <% destinations.forEach((destination) => { %>
              <button type="button" class="destination-option<%= destination.default_location ? ' default-destination' : '' %><%= destination.assigned_bathroom ? ' assigned-bathroom' : '' %>" role="option" aria-selected="false" data-destination-option data-default-location="<%= (destination.default_location || destination.assigned_bathroom) ? 'true' : 'false' %>" data-location-id="<%= destination.id %>" data-location-name="<%= destination.name %>" data-search-text="<%= `${destination.name} ${destination.teacher_name || ''} ${destination.bathroom_name || ''}` %>" <%= (destination.default_location || destination.assigned_bathroom) ? '' : 'hidden' %> <% if (waitingForApproval) { %> disabled <% } %>>
                <strong><%= destination.name %></strong>
                <% if (destination.assigned_bathroom) { %><div class="location-cont"><img src="/images/alert-circle-outline.svg" width="15" height="15">Assigned bathroom</div><% } %>
                <% if (destination.teacher_name) { %><div class="location-cont"><img src="/images/person.svg" width="15" height="15"><%= destination.teacher_name %></div><% } %>
                <% if (destination.bathroom_name) { %><div class="location-cont"><img src="/images/toilet.png" width="15" height="15"><%= destination.bathroom_name %></div><% } %>
              </button>
            <% }) %>
            <p class="destination-empty" data-destination-empty hidden>No matching locations.</p>
          </div>
          <% if (!waitingForApproval) { %><button type="submit" class="primary-button">Request teacher approval</button><% } else { %><p class="kiosk-lock-note" role="status">Destination locked: waiting for teacher approval.</p><% } %>
        </form>
      </section>
    <% } %>
  </div>
</section>
<% if (waitingForApproval && kioskSession) { %>
  <script src="/js/kiosk-pass-status.js?v=3" defer></script>
<% } %>
<% if (kioskSession) { %>
  <script src="/js/kiosk-manager.js?v=2" defer></script>
<% } %>
