<section class="auth-card">
  <h1>Forgot password?</h1>
  <p class="auth-description">ⓘ Enter the email address associated with your account and we’ll send a reset link if it’s registered.</p>
  <% if (message) { %>
    <p class="flash" role="status"><%= message %></p>
  <% } %>
  <form class="auth-form" method="post" action="/auth/forgot">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
    <label>Email <input name="email" type="email" required autocomplete="email" /></label>
    <button type="submit">Send reset link</button>
  </form>
  <p class="auth-footer-link"><a href="/auth/login">Back to sign in</a></p>
</section>
